# Copy to .env.local and fill in. Never commit real values.
GOOGLE_MAPS_API_KEY=
GOOGLE_SERVER_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BLS_API_KEY=
HUD_API_TOKEN=
# Descriptive User-Agent with contact info, required by BLS bulk downloads,
# e.g. "PriceMyNewRoof config build (you@example.com)"
BLS_USER_AGENT=
LLM_API_KEY=
# SERVICE_DIRECT_*: names to be confirmed once Service Direct answers arrive
SERVICE_DIRECT_API_KEY=
OPENAI_PIXEL_ID=
OPENAI_CAPI_TOKEN=
CRON_SECRET=
WEBHOOK_SECRET=
# Milestone 4
# Supabase anon (publishable) key for admin sign-in (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only email allowed into /admin (defaults to the owner's address).
ADMIN_EMAIL=
# Public site URL used in emails and links (defaults to https://pricemynewroof.com).
SITE_URL=
# Optional overrides of the code default (manual / form). none = development only.
BUYER_MODE=
PRIMARY_CTA=
# 1 = OpenAI Conversions API validates events without saving them.
OPENAI_CAPI_VALIDATE_ONLY=
